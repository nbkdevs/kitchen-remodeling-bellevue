{
  "name": "bellevuekitchenpros/kitchen-remodeling-cost",
  "description": "Kitchen remodeling cost planner: split a kitchen remodel budget by line item, add sales tax, a contingency reserve and permits. Cost vs Value presets. Library + CLI, no dependencies.",
  "type": "library",
  "keywords": ["kitchen remodeling", "kitchen remodel cost", "remodel budget", "renovation", "calculator", "sales tax", "home improvement"],
  "homepage": "https://wakitchenremodelingbellevue.com/",
  "license": "MIT",
  "authors": [{ "name": "Bellevue Kitchen Pros", "homepage": "https://wakitchenremodelingbellevue.com/" }],
  "support": {
    "issues": "https://github.com/nbkdevs/kitchen-remodeling-bellevue/issues",
    "source": "https://github.com/nbkdevs/kitchen-remodeling-bellevue"
  },
  "require": { "php": ">=8.1" },
  "require-dev": { "phpunit/phpunit": "^10.5 || ^11.0" },
  "autoload": { "psr-4": { "BellevueKitchenPros\\KitchenRemodelingCost\\": "packages/packagist/src/" } },
  "autoload-dev": { "psr-4": { "BellevueKitchenPros\\KitchenRemodelingCost\\Tests\\": "packages/packagist/tests/" } },
  "bin": ["packages/packagist/bin/kitchen-remodeling-cost"],
  "scripts": { "test": "phpunit -c packages/packagist/phpunit.xml" },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
