{
  "manifest_version": 3,
  "name": "Cabinet & Countertop Measure",
  "short_name": "Counter Measure",
  "version": "1.0.0",
  "description": "Countertop square footage with cutouts, backsplash tile counts and cabinet runs in standard widths. Offline, no permissions.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Cabinet & Countertop Measure"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": []
}